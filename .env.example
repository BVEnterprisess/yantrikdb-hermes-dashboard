# YantrikDB dashboard runtime configuration
YANTRIKDB_DASHBOARD_HOST=127.0.0.1
YANTRIKDB_DASHBOARD_PORT=8767
YANTRIKDB_DB_PATH=~/.hermes/yantrikdb-memory.db
YANTRIKDB_NAMESPACE=hermes
YANTRIKDB_DASHBOARD_NAMESPACE=hermes:hermes:default
# Set only if you want mutating admin endpoints enabled at launch:
# YANTRIKDB_DASHBOARD_ADMIN_MODE=true

# Supabase Auth for YantrikDB for Hermes Dashboard.
# The publishable key is intended for browser clients. Never use a service_role
# or sb_secret key here.
SUPABASE_URL=https://uhujussjcnoacqhavsqg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_qCDzNwEnGkhfCkHJLbrAcQ_XRp43g_a

# Optional. Set this to the canonical HTTPS callback URL for a deployed app.
# Add the same URL to Supabase Dashboard > Authentication > URL Configuration.
# Local default when omitted: <dashboard-origin>/login
# SUPABASE_AUTH_REDIRECT_URL=https://your-dashboard.example.com/login
